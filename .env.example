# Database Configuration
PG_DSN=postgresql://username:password@localhost:5432/mlb_db

# API Keys
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Data Collection Settings  
OUTPUT_DIR=stage

# Optional: Rate Limiting (seconds between API calls)
MLB_API_DELAY=0.2
WEATHER_API_DELAY=0.1

# Optional: Data Quality Thresholds
MIN_GAMES_FOR_ANALYSIS=10
MIN_SAMPLE_SIZE_UMPIRE=20