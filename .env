# Basic settings
OUTPUT_DIR=stage
DEBUG=false
LOG_LEVEL=INFO
VERBOSE=false

# Enhanced Data Quality Thresholds
MIN_GAMES_FOR_ANALYSIS=5
MIN_SAMPLE_SIZE_UMPIRE=15
MIN_PITCHER_STARTS=3
MIN_TEAM_GAMES=7

# Enhanced Betting Analysis Thresholds
STRONG_EDGE_THRESHOLD=0.12
MODERATE_EDGE_THRESHOLD=0.06
