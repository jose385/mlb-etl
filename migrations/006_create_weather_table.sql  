-- Weather data table for comprehensive game conditions
-- Save this as migrations/006_create_weather_table.sql

CREATE TABLE IF NOT EXISTS public.weather (
  -- Game identifiers
  game_date DATE NOT NULL,
  game_pk INTEGER NOT NULL,
  venue_name TEXT,
  home_team TEXT,
  away_team TEXT,
  
  -- Stadium location
  stadium_lat REAL,
  stadium_lon REAL,
  stadium_elevation REAL,
  
  -- Basic weather measurements
  temperature_f REAL,
  humidity_pct INTEGER,
  pressure_mb REAL,
  wind_speed_mph REAL,
  wind_direction_deg INTEGER,
  
  -- Advanced meteorological calculations
  air_density_kg_m3 REAL,
  hr_distance_factor_ft REAL,
  wind_x_component REAL,
  wind_y_component REAL,
  
  -- Game impact scores (0-100 scale)
  pitcher_advantage_score REAL,
  hitter_advantage_score REAL,
  weather_impact_score REAL,
  
  -- Data quality
  data_source TEXT DEFAULT 'openweather_api',
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  
  PRIMARY KEY (game_pk)
);

-- Indexes for efficient querying
CREATE INDEX IF NOT EXISTS idx_weather_game_date ON public.weather(game_date);
CREATE INDEX IF NOT EXISTS idx_weather_temperature ON public.weather(temperature_f);
CREATE INDEX IF NOT EXISTS idx_weather_wind_speed ON public.weather(wind_speed_mph);
CREATE INDEX IF NOT EXISTS idx_weather_impact ON public.weather(weather_impact_score);
CREATE INDEX IF NOT EXISTS idx_weather_home_team ON public.weather(home_team);

-- Comments for documentation
COMMENT ON TABLE public.weather IS 'Comprehensive weather data for MLB games affecting player performance and game outcomes';
COMMENT ON COLUMN public.weather.hr_distance_factor_ft IS 'Estimated change in home run distance due to weather conditions (feet)';
COMMENT ON COLUMN public.weather.air_density_kg_m3 IS 'Air density affecting ball flight physics';