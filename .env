# Legacy Feature Flags (for backward compatibility)
ENABLE_FATIGUE_METRICS=false

# =============================================================================
# USAGE INSTRUCTIONS:
# =============================================================================
# 
# 🔧 PLACEHOLDER MODE (Recommended for testing):
#    USE_PLACEHOLDER_DATA=false
#    - Fast, reliable data generation
#    - Works for any date (including 2025)
#    - Perfect for testing the pipeline
#    - No API rate limits or failures
#
# 🌐 REAL DATA MODE (For production):
#    USE_PLACEHOLDER_DATA=false  
#    - Uses real MLB APIs
#    - Slower, may hit rate limits
#    - Only works for past dates with real games
#    - Requires stable internet connection
#
# 🎯 QUICK START:
