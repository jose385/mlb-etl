# API Error Handling (NEW)
API_RETRY_COUNT=3
API_TIMEOUT_SECONDS=30.0
GRACEFUL_API_DEGRADATION=true

# Enhanced Rate Limiting (adjusted for stability)
MLB_API_DELAY=0.5
