# Enhanced MLB Betting Analysis Environment Configuration
# Updated for 9-table enhanced schema

# Database Configuration (REQUIRED)
PG_DSN=postgresql://username:password@localhost:5432/mlb_betting_enhanced

# API Keys (CONDITIONAL - required for specific features)
OPENWEATHER_API_KEY=d4b2c92bf5f2ccb4ff4d91b160de9235
# Get free key at: https://openweathermap.org/api

# Data Collection Settings
OUTPUT_DIR=stage
MIGRATIONS_DIR=migrations
LOG_DIR=logs

# Enhanced Rate Limiting (seconds between API calls)
MLB_API_DELAY=0.2
WEATHER_API_DELAY=0.5
STATS_API_DELAY=0.3

# Enhanced Data Quality Thresholds
MIN_GAMES_FOR_ANALYSIS=5
MIN_SAMPLE_SIZE_UMPIRE=15
MIN_PITCHER_STARTS=3
MIN_TEAM_GAMES=7

# Enhanced Betting Analysis Thresholds
STRONG_EDGE_THRESHOLD=0.12
MODERATE_EDGE_THRESHOLD=0.06
WEATHER_IMPACT_THRESHOLD=0.08

# Enhanced Feature Flags (true/false)
ENABLE_WEATHER=true
ENABLE_UMPIRE_ANALYSIS=true
ENABLE_VENUE_FACTORS=true
ENABLE_RECENT_STATS=true
ENABLE_GAME_INFO=true

# New Enhanced Features
ENABLE_PITCHER_WORKLOAD=true
ENABLE_TEAM_FORM_ANALYSIS=true
ENABLE_BALLPARK_ADJUSTMENTS=true

# Debug/Development Settings
DEBUG=false
VERBOSE=false
DRY_RUN=false

# Enhanced Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
PERFORMANCE_MONITORING=false