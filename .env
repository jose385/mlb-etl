# Enhanced Feature Flags (true/false)
ENABLE_UMPIRE_ANALYSIS=true
ENABLE_VENUE_FACTORS=true
ENABLE_RECENT_STATS=true
ENABLE_GAME_INFO=true
ENABLE_PITCHER_WORKLOAD=true
ENABLE_TEAM_FORM_ANALYSIS=true
