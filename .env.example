# Database Configuration (REQUIRED)
PG_DSN=postgresql://username:password@localhost:5432/mlb_db

# API Keys (CONDITIONAL - required for specific features)
OPENWEATHER_API_KEY=0fa1b0b1fa82db0e5f8f139bfc80e7b8
# Get free key at: https://openweathermap.org/api

# Data Collection Settings
OUTPUT_DIR=stage
MIGRATIONS_DIR=migrations
LOG_DIR=logs

# Rate Limiting (seconds between API calls)
MLB_API_DELAY=0.1
WEATHER_API_DELAY=0.2

# Data Quality Thresholds
MIN_GAMES_FOR_ANALYSIS=10
MIN_SAMPLE_SIZE_UMPIRE=20

# Betting Analysis Thresholds
STRONG_EDGE_THRESHOLD=0.15
MODERATE_EDGE_THRESHOLD=0.08

# Feature Flags (true/false)
ENABLE_WEATHER=true
ENABLE_UMPIRE_ANALYSIS=true
ENABLE_FATIGUE_METRICS=true

# Debug/Development Settings
DEBUG=false
VERBOSE=false
DRY_RUN=false