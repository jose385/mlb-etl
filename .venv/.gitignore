# MLB Betting Analysis .gitignore
# Enhanced for proper directory structure management

# =============================================================================
# DATA FILES (Never commit actual data)
# =============================================================================
*.parquet
*.csv
*.json
*.pkl
*.pickle

# Data directories
stage/
!stage/.gitkeep
backup/
!backup/.gitkeep

# Specific data patterns
**/data_*.parquet
**/mlb_*.csv
**/statcast_*.parquet
**/weather_*.json

# =============================================================================
# ENVIRONMENT AND SECRETS
# =============================================================================
.env
.env.*
!.env.example
!.env.template

# API keys and credentials
*api_key*
*secret*
*password*
*credentials*
.aws/credentials
.boto
credentials.json

# =============================================================================
# PYTHON
# =============================================================================
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Virtual environments
venv/
env/
ENV/
.env/
.venv/
.ENV/
env.bak/
venv.bak/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# =============================================================================
# LOGS AND TEMPORARY FILES
# =============================================================================
logs/
!logs/.gitkeep
*.log
*.log.*

# Temporary files
*.tmp
*.temp
.cache/
.tmp/

# =============================================================================
# DATABASE
# =============================================================================
*.db
*.sqlite
*.sqlite3
*.db-journal

# Database dumps
*.sql.gz
*.dump

# =============================================================================
# IDE AND EDITORS
# =============================================================================
# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml
*.ipr
*.iws

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Sublime Text
*.sublime-workspace
*.sublime-project

# =============================================================================
# OPERATING SYSTEM
# =============================================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# =============================================================================
# AWS AND CLOUD
# =============================================================================
.aws/
.s3cfg
.boto

# =============================================================================
# DOCUMENTATION BUILDS
# =============================================================================
docs/_build/
docs/.doctrees/
site/
.readthedocs.yml

# =============================================================================
# CONTAINER AND DEPLOYMENT
# =============================================================================
.dockerignore
Dockerfile.local
docker-compose.override.yml

# =============================================================================
# PROJECT SPECIFIC
# =============================================================================
# Configuration backups
config/backup/
*.conf.bak

# Model files (if you train models)
*.model
*.pkl
models/
!models/.gitkeep

# Output files
output/
results/
reports/
!reports/.gitkeep

# Archive files
*.zip
*.tar.gz
*.rar
*.7z

# =============================================================================
# KEEP IMPORTANT EMPTY DIRECTORIES
# =============================================================================
# These are handled by .gitkeep files in respective directories:
# logs/.gitkeep
# stage/.gitkeep
# backup/.gitkeep
# tests/.gitkeep

# =============================================================================
# ALLOW CRITICAL SETUP FILES
# =============================================================================
# These should always be committed:
!setup_env.py
!setup_directories.py
!check_env.py
!initialize_database.py
!validate_setup.py
!create_dirs.sh
!requirements.txt
!migrations/*.sql
!py/__init__.py

# =============================================================================
# DEVELOPMENT AND TESTING
# =============================================================================
.coverage
.coveragerc
.pytest_cache/
htmlcov/
.tox/
test-reports/

# Performance profiling
*.prof
*.lprof

# =============================================================================
# SECURITY SCANNING
# =============================================================================
.bandit
.safety
security-report.json

# =============================================================================
# MISC
# =============================================================================
.DS_Store
*.bak
*.orig
*.rej
*.swp
*.tmp

# Node.js (if you add any JS tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =============================================================================
# CUSTOM PATTERNS (Add your specific ignores here)
# =============================================================================
# Add any project-specific files you want to ignore
# custom_config.py
# local_settings.py